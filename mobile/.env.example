# Copy to .env.local (not in git) and fill in. Only PUBLIC values belong here: everything EXPO_PUBLIC_ ends up inside the app.
# Never put the service_role / sb_secret_ key, the database password, the Resend key or the RevenueCat secret here.

# Supabase > Project Settings > API: Project URL and the anon (or sb_publishable_...) key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat > Project > API keys: the public SDK keys (appl_... and goog_...)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Cloudflare Turnstile (public, docs/ZASTITA.md 3.3): the widget's site key and one host name from its hostname list
# (just the name, e.g. lockintracker.com). Both empty = no CAPTCHA token is sent (CAPTCHA must stay off in Supabase).
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
EXPO_PUBLIC_TURNSTILE_HOSTNAME=
